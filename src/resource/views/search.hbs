<div class='mt-4'>
  <form method='POST' as action=''>
    <div class='mb-3'>
      <label for='search-input' class='form-label'>Nhập từ khóa</label>
      <input
        type='text'
        name='q'
        class='form-control'
        id='searh-input'
        placeholder='Nhập từ khóa...'
      />
    </div>
    <div class='form-group'>
      <label for='gender-input'>Nhập giới tính</label>
      <select name='gender' class='form-control' id='gender-input'>
        <option value='male'>Nam</option>
        <option value='female'>Nữ</option>
      </select>
    </div>
    <button type='submit' class='btn btn-primary'>Tim kiếm</button>
  </form>
</div>