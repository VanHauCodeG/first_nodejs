<div class="container py-5">
  <!-- Tiêu đề trang -->
  <div class="text-center mb-5">
    <h2 class="fw-bold text-dark">Danh Sách Khóa Học</h2>
    <p class="text-muted">Khám phá các khóa học mới nhất để nâng cao kiến thức</p>
  </div>

  <!-- Vòng lặp danh sách khóa học -->
  <div class="row g-4">
    {{#each courses}}
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden course-card">
        
        <!-- Hình ảnh khóa học -->
        <div class="position-relative">
          <a href="/courses/{{this.slug}}">
          <img src="{{this.img}}" class="card-img-top course-img" alt="{{this.name}}">
          </a>
        </div>

        <!-- Nội dung khóa học -->
        <div class="card-body d-flex flex-column p-4">
          <h5 class="card-title fw-bold text-dark mb-2">{{this.name}}</h5>
          <p class="card-text text-secondary flex-grow-1">{{this.description}}</p>
          
          <div class="mt-3 pt-3 border-top">
            <a href="/courses/{{this.slug}}" class="btn btn-primary w-100 rounded-3 py-2 fw-semibold">Xem khóa học</a>
          </div>
        </div>

      </div>
    </div>
    {{/each}}
  </div>
</div>

<!-- CSS cố định chiều cao ảnh và hiệu ứng hover -->
<style>
  .course-img {
    height: 200px;
    object-fit: cover; /* Giúp ảnh luôn vừa vặn không bị méo tỉ lệ */
  }
  .course-card {
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .course-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1) !important;
  }
</style>